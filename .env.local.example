# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored by default — never commit it.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
# Both of these are PUBLIC by design and safe in the browser bundle.
# What protects your data is Row Level Security, not secrecy of the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# https://console.anthropic.com → API keys
# NO `NEXT_PUBLIC_` PREFIX. That prefix is what makes a variable public;
# without it, Next.js keeps this value server-side only and it never appears
# in the JavaScript sent to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — override the model used by the three Generate buttons.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
